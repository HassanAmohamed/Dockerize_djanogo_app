pipeline {
    agent any

    stages {
        stage("Clone Code") {
            steps {
                echo "Cloning the code from Git repository"
                git url: "https://github.com/HassanAmohamed/Dockerize_djanogo_app.git", branch: "dev"
            }
        }

        stage("Build Docker Image") {
            steps {
                echo "Building the Docker image"
                sh "docker build -t discussion-board-app ."
            }
        }

        stage("Push to Docker Hub") {
            steps {
                echo "Pushing the Docker image to Docker Hub"
                withCredentials([usernamePassword(credentialsId: "dockerHub", passwordVariable: 'DOCKER_HUB_PASSWORD', usernameVariable: 'DOCKER_HUB_USERNAME')]) {
                    sh """
                        docker login -u $DOCKER_HUB_USERNAME -p $DOCKER_HUB_PASSWORD || exit 1
                        docker tag discussion-board-app $DOCKER_HUB_USERNAME/discussion-board-app:latest || exit 1
                        docker push $DOCKER_HUB_USERNAME/discussion-board-app:latest || exit 1
                    """
                }
            }
        }

        stage("Deploy") {
            steps {
                echo "Deploying the container using Docker Compose"
                sh "docker-compose down && docker-compose up -d"
            }
        }
    }

    post {
        always {
            echo "Cleaning up Docker Hub credentials"
            sh "docker logout"
        }
        success {
            echo "Pipeline executed successfully!"
        }
        failure {
            echo "Pipeline failed. Check the logs for details."
        }
    }
}